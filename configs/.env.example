# Solana Trading Engine environment
# NEVER commit real API keys, wallet secrets, seed phrases, or private keys.

TRADING_MODE=observe
RUST_LOG=info,solana_trading_engine=debug

# Put your NEW Helius key only in your deployment/secret manager.
# Do not put the real URL in this file.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# PumpPortal market-data WebSocket
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Server-side persistence only
SUPABASE_URL=https://jmoevyherwgrcsxhehpe.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
TRADING_MODE=paper
